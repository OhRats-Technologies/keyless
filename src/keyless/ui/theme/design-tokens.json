{
  "schema_version": 1,
  "description": "Single source of truth for the Keyless desktop design tokens, aligned with OhRats-Technologies/ui/css/tokens.css.",
  "themes": {
    "light": {
      "background": "#efede5",
      "surface": "#ffffff",
      "surface_alt": "#f5f3ec",
      "sidebar": "#efede5",
      "text": "#1a1a1b",
      "muted": "#595550",
      "accent": "#c95b2b",
      "accent_text": "#ffffff",
      "border": "#634936",
      "danger": "#d95555",
      "success": "#2f9e62",
      "warning": "#9c6500",
      "selected": "#f5f3ec"
    },
    "dark": {
      "background": "#1a1a1b",
      "surface": "#202021",
      "surface_alt": "#2a2a2b",
      "sidebar": "#1a1a1b",
      "text": "#efede5",
      "muted": "#a3a393",
      "accent": "#e27a3b",
      "accent_text": "#1a1a1b",
      "border": "#634936",
      "danger": "#e26464",
      "success": "#43b777",
      "warning": "#e0b25c",
      "selected": "#2a2a2b"
    }
  },
  "accent": {
    "role": "accent",
    "text_role": "accent_text",
    "note": "Canonical OhRats terracotta-amber signal accent (#c95b2b light / #e27a3b dark) with espresso structural hairlines (#634936)."
  },
  "typography": {
    "font_family": "Inter, \"Noto Sans\", \"DejaVu Sans\", sans-serif",
    "mono_family": "\"MesloLGS Nerd Font Mono\", \"Space Mono\", monospace",
    "sizes": {
      "body": 14,
      "title": 26,
      "heading": 16,
      "small": 11
    },
    "line_heights": {
      "body": 1.45,
      "title": 1.2,
      "heading": 1.3,
      "small": 1.3
    },
    "telemetry_numerals": "tabular"
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32
  },
  "radii": {
    "default": 10,
    "small": 4,
    "pill": 14
  },
  "elevation": {
    "flat": {
      "background_role": "background",
      "border_role": "border",
      "shadow": "none"
    },
    "raised": {
      "background_role": "surface",
      "border_role": "border",
      "shadow": "none"
    },
    "overlay": {
      "background_role": "surface",
      "border_role": "border",
      "shadow": "0 8px 24px rgba(0, 0, 0, 0.18)"
    }
  }
}
